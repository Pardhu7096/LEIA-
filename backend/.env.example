# LEIA backend settings. Copy to backend/.env for local development, or to
# /opt/leia/<environment>/shared/.env on a server (owner: deploy user, mode 640).
# Never commit a real .env. `python preflight.py --deployed` validates a server file.

# PostgreSQL. Staging and production must use different databases and passwords.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=leia
DB_USER=leia_app
DB_PASSWORD=CHANGE_ME_database_password
# Required when the database is on another host (for example Amazon RDS):
# DB_SSLMODE=require

# At least 32 characters, different per environment. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_unique_secret_per_environment

# AI assistant.
GROQ_API_KEY=CHANGE_ME_groq_api_key

# Servers only (HTTPS). Leave both lines out for local development.
# COOKIE_SECURE=true
# LEIA_ALLOWED_ORIGINS=https://app.example.com,https://crm.example.com

# Optional: nearby places and walking estimates. Restrict each key to its one
# Google API and to this server's address in Google Cloud.
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
