*.mp4
*.mov
*.wav
*.mp3

# Android signing material and build outputs: never commit (public repo).
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
*.apk
*.aab
*.idsig
build-manifest.json

# Build-installed tools (scripts/render/install-ffprobe.sh)
backend/bin/

# EAS uploads only what an app build needs (no backend, docs, scripts or reports)
backend/
docs/
scripts/
backups/
.github/
*.diff
*.sql
